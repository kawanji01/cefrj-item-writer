<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CEFR-J {{ format_name }} {{ set_data.level.value }}（{{ set_data.set_id }}）</title>
<style>
:root {
  --color-bg: #ffffff;
  --color-text: #1f2328;
  --color-muted: #57606a;
  --color-accent: #0a58ca;
  --color-correct: #0f5132;
  --color-correct-bg: #d1e7dd;
  --color-wrong: #842029;
  --color-wrong-bg: #f8d7da;
  --color-border: #d0d7de;
}
* {
  box-sizing: border-box;
}
html {
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Hiragino Sans", "Noto Sans CJK JP", "Yu Gothic", Meiryo, sans-serif;
  font-size: 16px;
}
body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  line-height: 1.65;
  overflow-wrap: break-word;
}
.site-header,
#screen-ui,
#worksheet,
#answer-key,
#attribution,
.noscript-note {
  width: 100%;
  max-width: 720px;
  margin-inline: auto;
  padding-inline: 16px;
}
.site-header {
  padding-block: 24px 12px;
  border-bottom: 1px solid var(--color-border);
}
h1,
h2,
h3,
p {
  margin-block-start: 0;
}
h1 {
  font-size: 1.75rem;
  line-height: 1.3;
}
h2 {
  font-size: 1.3rem;
}
h3 {
  font-size: 1.1rem;
}
.set-meta,
.deck-progress,
.score {
  color: var(--color-muted);
}
#screen-ui {
  padding-block: 24px 40px;
}
.instruction {
  font-weight: 700;
  margin-bottom: 20px;
}
.question,
.card,
.deck-summary {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 20px;
}
.stem,
.stem-sentence,
.sentence,
.context-sentence,
.source-line,
.instruction-line,
.ja-hint {
  font-size: 1.125rem;
}
.target {
  font-weight: 700;
  text-decoration: underline;
  text-decoration-thickness: 2px;
}
.pos,
.label {
  font-weight: 700;
}
.blank {
  display: inline-block;
  min-width: 7ch;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.choices,
.unknown-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.choices li + li {
  margin-top: 8px;
}
button,
input,
summary {
  min-height: 44px;
  font: inherit;
}
button {
  min-width: 44px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 10px 14px;
  background: var(--color-bg);
  color: var(--color-text);
  cursor: pointer;
}
button:disabled {
  cursor: default;
  opacity: 0.72;
}
button:not(:disabled):hover {
  border-color: var(--color-accent);
}
:focus-visible {
  outline: 3px solid var(--color-accent);
  outline-offset: 2px;
}
.choice {
  width: 100%;
  text-align: start;
}
.choice-label {
  display: inline-block;
  min-width: 2em;
  font-weight: 700;
}
.is-correct {
  background: var(--color-correct-bg);
  color: var(--color-correct);
  font-weight: 700;
}
.is-wrong {
  background: var(--color-wrong-bg);
  color: var(--color-wrong);
  font-weight: 700;
}
.choice.is-correct:disabled,
.choice.is-wrong:disabled {
  opacity: 1;
}
.feedback {
  min-height: 1.65em;
  font-weight: 700;
  margin-top: 12px;
}
.translation-line,
.answer-line,
.user-answer-line,
.explanation,
.explanation-full {
  margin-top: 12px;
}
.explanation summary {
  padding-block: 8px;
  color: var(--color-accent);
  font-weight: 700;
  cursor: pointer;
}
.cloze-slot input {
  width: min(100%, 15em);
  min-height: 44px;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  padding: 8px;
  color: var(--color-text);
  background: var(--color-bg);
  font-size: 16px;
}
.cue {
  white-space: nowrap;
}
.card-front,
.card-back {
  min-height: 120px;
}
.card-actions,
.selfcheck-actions,
.reorder-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}
.token-bank,
.answer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8px;
  min-height: 60px;
  padding: 8px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  margin-bottom: 12px;
}
.answer-row {
  border-style: dashed;
}
.token.is-used {
  text-decoration: line-through;
}
.score {
  font-weight: 700;
  margin-top: 20px;
}
#attribution {
  padding-block: 24px 40px;
  border-top: 1px solid var(--color-border);
}
.print-only {
  display: none;
}
[hidden] {
  display: none !important;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.print-question,
.print-answer {
  break-inside: avoid;
  page-break-inside: avoid;
  margin-bottom: 18px;
}
.print-line {
  border-bottom: 1px solid var(--color-text);
  min-height: 2em;
  margin-bottom: 8px;
}
.print-choices {
  margin-left: 1em;
}
@page {
  size: A4;
  margin: 15mm;
}
@media print {
  #screen-ui,
  noscript,
  .screen-only {
    display: none !important;
  }
  #worksheet,
  #answer-key,
  .print-only {
    display: block;
  }
  .site-header,
  #worksheet,
  #answer-key,
  #attribution {
    max-width: none;
    padding-inline: 0;
  }
  #answer-key {
    break-before: page;
    page-break-before: always;
  }
  .target {
    font-weight: 700;
    text-decoration: underline;
  }
}
</style>
</head>
<body>
<header class="site-header">
  <h1>{{ format_name }}（{{ set_data.level.value }}）</h1>
  <p class="set-meta">セットID: {{ set_data.set_id }} ／ 問題数: {{ questions|length }}問 ／ 作成日: {{ set_data.created_at }}{% if set_data.topic is not none %} ／ トピック: {{ set_data.topic }}{% endif %}</p>
</header>
<noscript><p class="noscript-note">この教材の対話機能を使うにはJavaScriptを有効にしてください。印刷用の紙面はJavaScriptなしで利用できます。</p></noscript>
<main id="screen-ui" class="screen-only">
  <p class="instruction">{{ instruction }}</p>
{% if set_data.format in ["vocab_mcq_en2ja", "vocab_mcq_ja2en", "grammar_mcq"] %}
{% for question in questions %}
  <section class="question" id="{{ question.question_id }}" data-format="{{ set_data.format }}" data-answer-index="{{ question.answer_index|json_attr }}">
    <h2>問{{ question.number }}</h2>
{% if set_data.format == "vocab_mcq_en2ja" %}
    <p class="stem"><span lang="en">{{ question.body.stem|highlight(question.body.target_surface) }}</span> <span class="pos">{{ question.pos_label }}</span></p>
{% elif set_data.format == "vocab_mcq_ja2en" %}
    <p class="stem">{{ question.body.stem }}</p>
    <p class="stem-sentence" lang="en">{{ question.body.sentence_with_blank|blank_display }}</p>
{% else %}
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p class="stem" lang="en">{{ question.body.sentence_with_blank|blank_display }}</p>
{% endif %}
    <ul class="choices" role="list">
{% for choice in question.body.choices %}
      <li><button type="button" class="choice" data-index="{{ loop.index0 }}"{% if set_data.format != "vocab_mcq_en2ja" %} lang="en"{% endif %}><span class="choice-label">{{ choice_labels[loop.index0] }}</span> <span class="choice-text">{{ choice.text }}</span></button></li>
{% endfor %}
    </ul>
    <p class="feedback" role="status"></p>
{% if set_data.format == "vocab_mcq_en2ja" %}
    <p class="translation-line" hidden><span class="label">日本語訳: </span>{{ question.body.stem_ja }}</p>
{% elif set_data.format == "vocab_mcq_ja2en" %}
    <p class="translation-line" hidden><span lang="en">{{ question.body.sentence_complete }}</span><br><span class="label">日本語訳: </span>{{ question.body.sentence_ja }}</p>
{% else %}
    <details class="explanation" hidden><summary>解説</summary><p>{{ question.explanation.text }}</p></details>
    <p class="translation-line" hidden><span class="label">日本語訳: </span>{{ question.body.example_ja }}</p>
{% endif %}
  </section>
{% endfor %}
  <p class="score" role="status">正解数: 0 / {{ questions|length }}</p>
{% elif set_data.format in ["vocab_flashcard_en2ja", "vocab_flashcard_ja2en"] %}
  <section class="deck" data-format="{{ set_data.format }}">
    <p class="deck-progress" role="status">1 / {{ questions|length }}</p>
{% for question in questions %}
    <div class="card" id="{{ question.question_id }}" data-state="front"{% if not loop.first %} hidden{% endif %}>
      <div class="card-front">
{% if set_data.format == "vocab_flashcard_en2ja" %}
        <p class="sentence" lang="en">{{ question.body.example.en|highlight(question.body.target_surface) }}</p>
{% else %}
        <p class="translation">{{ question.body.example.ja }}</p>
{% endif %}
      </div>
      <div class="card-back" hidden>
{% if set_data.format == "vocab_flashcard_en2ja" %}
        <p class="translation"><span class="label">日本語訳: </span>{{ question.body.example.ja }}</p>
{% else %}
        <p class="sentence" lang="en">{{ question.body.example.en|highlight(question.body.target_surface) }}</p>
{% endif %}
        <p class="gloss"><span class="label">語義: </span><span lang="en">{{ question.body.headword }}</span> {{ question.pos_label }} {{ question.body.gloss }}</p>
      </div>
      <div class="card-actions">
        <button type="button" class="flip">答えを見る</button>
        <button type="button" class="mark-known" hidden>覚えた</button>
        <button type="button" class="mark-unknown" hidden>まだ</button>
      </div>
    </div>
{% endfor %}
    <div class="deck-summary" hidden>
      <h2>結果</h2>
      <p class="score" role="status">覚えた: 0 / {{ questions|length }}</p>
      <h3 class="unknown-heading">まだのカード</h3>
      <ul class="unknown-list" role="list"></ul>
      <button type="button" class="restart">もう一度最初から</button>
    </div>
  </section>
{% elif set_data.format in ["grammar_cloze", "grammar_rewrite"] %}
{% for question in questions %}
  <section class="question" id="{{ question.question_id }}" data-format="{{ set_data.format }}" data-accepted='{{ question.accepted|json_attr }}'>
    <h2>問{{ question.number }}</h2>
{% if set_data.format == "grammar_cloze" %}
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p class="stem" lang="en">{{ blank_input(question.body.sentence_with_blank, question.question_id, question.body.cue) }}</p>
{% else %}
    <p class="source-line"><span class="label">元の文: </span><span lang="en">{{ question.body.source_sentence }}</span></p>
    <p class="instruction-line"><span class="label">指示: </span>{{ question.body.instruction }}</p>
    <p class="stem"><span class="label">書き換え後: </span><span lang="en">{{ blank_input(question.body.target_sentence_with_blank, question.question_id) }}</span></p>
{% endif %}
    <button type="button" class="check" disabled>答え合わせ</button>
    <p class="feedback" role="status"></p>
    <p class="user-answer-line" hidden><span class="label">あなたの解答: </span><span lang="en" class="user-answer"></span></p>
    <p class="answer-line" hidden><span class="label">正解: </span><span lang="en">{% if set_data.format == "grammar_cloze" %}{{ question.body.answer }}{% else %}{{ question.completed_target }}{% endif %}</span></p>
    <details class="explanation" hidden><summary>解説</summary><p>{{ question.explanation.text }}</p></details>
  </section>
{% endfor %}
  <p class="score" role="status">正解数: 0 / {{ questions|length }}</p>
{% elif set_data.format == "grammar_reorder" %}
{% for question in questions %}
  <section class="question" id="{{ question.question_id }}" data-format="grammar_reorder" data-answer-tokens='{{ question.body.answer_tokens|json_attr }}'>
    <h2>問{{ question.number }}</h2>
    <p class="ja-hint">{{ question.body.example_ja }}</p>
    <div class="answer-row" role="group" aria-label="並べた語句"></div>
    <div class="token-bank" role="group" aria-label="語句の候補">
{% for token in question.body.tokens_shuffled %}
      <button type="button" class="token" lang="en" data-token="{{ token }}">{{ token }}</button>
{% endfor %}
    </div>
    <div class="reorder-actions">
      <button type="button" class="reset">やり直す</button>
      <button type="button" class="check" disabled>答え合わせ</button>
    </div>
    <p class="feedback" role="status"></p>
    <p class="user-answer-line" hidden><span class="label">あなたの解答: </span><span lang="en" class="user-answer"></span></p>
    <p class="answer-line" hidden><span class="label">正解: </span><span lang="en">{{ question.body.answer_sentence }}</span></p>
    <details class="explanation" hidden><summary>解説</summary><p>{{ question.explanation.text }}</p></details>
  </section>
{% endfor %}
  <p class="score" role="status">正解数: 0 / {{ questions|length }}</p>
{% else %}
{% for question in questions %}
  <section class="question" id="{{ question.question_id }}" data-format="grammar_example_selfcheck">
    <h2>問{{ question.number }}</h2>
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p class="sentence" lang="en">{{ question.body.example.en }}</p>
    <button type="button" class="reveal">答えを見る</button>
    <div class="answer-area" hidden>
      <p class="translation"><span class="label">日本語訳: </span>{{ question.body.example.ja }}</p>
      <div class="explanation-full"><h3>解説</h3><p>{{ question.explanation.text }}</p></div>
      <div class="selfcheck-actions">
        <button type="button" class="mark-ok">できた</button>
        <button type="button" class="mark-ng">できなかった</button>
      </div>
    </div>
    <p class="feedback" role="status"></p>
  </section>
{% endfor %}
  <p class="score" role="status">できた: 0 / {{ questions|length }}</p>
{% endif %}
</main>
<section id="worksheet" class="print-only">
  <h2>問題</h2>
  <p>{{ format_name }}（{{ set_data.level.value }}）</p>
  <p>{{ instruction }}</p>
  <p>名前：____________________</p>
{% for question in questions %}
  <section class="print-question">
{% if set_data.format in ["vocab_mcq_en2ja", "vocab_mcq_ja2en", "grammar_mcq"] %}
    <h3>問{{ question.number }}　答え（　　）</h3>
{% else %}
    <h3>問{{ question.number }}</h3>
{% endif %}
{% if set_data.format == "vocab_mcq_en2ja" %}
    <p><span lang="en">{{ question.body.stem|highlight(question.body.target_surface) }}</span> <span class="pos">{{ question.pos_label }}</span></p>
{% elif set_data.format == "vocab_mcq_ja2en" %}
    <p>{{ question.body.stem }}</p>
    <p lang="en">{{ question.body.sentence_with_blank|blank_display }}</p>
{% elif set_data.format == "vocab_flashcard_en2ja" %}
    <p lang="en">{{ question.body.example.en|highlight(question.body.target_surface) }}</p>
{% elif set_data.format == "vocab_flashcard_ja2en" %}
    <p>{{ question.body.example.ja }}</p>
{% elif set_data.format == "grammar_mcq" %}
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p lang="en">{{ question.body.sentence_with_blank|blank_display }}</p>
{% elif set_data.format == "grammar_cloze" %}
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p lang="en">{{ question.body.sentence_with_blank|blank_display }}</p>
{% elif set_data.format == "grammar_reorder" %}
    <p>{{ question.body.example_ja }}</p>
    <p lang="en">[ {{ question.body.tokens_shuffled|join(" / ") }} ]</p>
    <p class="print-line"></p>
{% elif set_data.format == "grammar_rewrite" %}
    <p><span class="label">元の文: </span><span lang="en">{{ question.body.source_sentence }}</span></p>
    <p><span class="label">指示: </span>{{ question.body.instruction }}</p>
    <p><span class="label">書き換え後: </span><span lang="en">{{ question.body.target_sentence_with_blank|blank_display }}</span></p>
{% else %}
{% if question.body.context_sentence is not none %}
    <p class="context-sentence" lang="en">{{ question.body.context_sentence }}</p>
{% endif %}
    <p lang="en">{{ question.body.example.en }}</p>
    <p class="print-line"></p>
    <p class="print-line"></p>
{% endif %}
{% if set_data.format in ["vocab_mcq_en2ja", "vocab_mcq_ja2en", "grammar_mcq"] %}
    <div class="print-choices">
{% for choice in question.body.choices %}
      <p>{% if set_data.format != "vocab_mcq_en2ja" %}<span lang="en">{% endif %}{{ choice_labels[loop.index0] }}　{{ choice.text }}{% if set_data.format != "vocab_mcq_en2ja" %}</span>{% endif %}</p>
{% endfor %}
    </div>
{% endif %}
  </section>
{% endfor %}
</section>
<section id="answer-key" class="print-only">
  <h2>解答・解説</h2>
{% for question in questions %}
  <section class="print-answer">
    <h3>問{{ question.number }}</h3>
{% if set_data.format == "vocab_mcq_en2ja" %}
    <p>{{ question.answer_label }}　{{ question.answer_text }}</p>
    <p>{{ question.body.stem_ja }}</p>
{% elif set_data.format == "vocab_mcq_ja2en" %}
    <p><span lang="en">{{ question.answer_label }}　{{ question.answer_text }}</span></p>
    <p lang="en">{{ question.body.sentence_complete }}</p>
    <p>{{ question.body.sentence_ja }}</p>
{% elif set_data.format == "vocab_flashcard_en2ja" %}
    <p lang="en">{{ question.body.example.en|highlight(question.body.target_surface) }}</p>
    <p><span class="label">日本語訳: </span>{{ question.body.example.ja }}</p>
    <p><span class="label">語義: </span><span lang="en">{{ question.body.headword }}</span> {{ question.pos_label }} {{ question.body.gloss }}</p>
{% elif set_data.format == "vocab_flashcard_ja2en" %}
    <p>{{ question.body.example.ja }}</p>
    <p lang="en">{{ question.body.example.en|highlight(question.body.target_surface) }}</p>
    <p><span class="label">語義: </span><span lang="en">{{ question.body.headword }}</span> {{ question.pos_label }} {{ question.body.gloss }}</p>
{% elif set_data.format == "grammar_mcq" %}
    <p><span lang="en">{{ question.answer_label }}　{{ question.answer_text }}</span></p>
    <p>{{ question.explanation.text }}</p>
{% elif set_data.format == "grammar_cloze" %}
    <p><span lang="en">{{ question.body.answer }}</span>{% if question.body.answer_equivalents %}（別解: {% for equivalent in question.body.answer_equivalents %}<span lang="en">{{ equivalent }}</span>{% if not loop.last %}, {% endif %}{% endfor %}）{% endif %}</p>
    <p>{{ question.explanation.text }}</p>
{% elif set_data.format == "grammar_reorder" %}
    <p lang="en">{{ question.body.answer_sentence }}</p>
    <p>{{ question.explanation.text }}</p>
{% elif set_data.format == "grammar_rewrite" %}
    <p lang="en">{{ question.completed_target }}</p>
    <p>{{ question.explanation.text }}</p>
{% else %}
    <p><span class="label">日本語訳: </span>{{ question.body.example.ja }}</p>
    <p>{{ question.explanation.text }}</p>
{% endif %}
  </section>
{% endfor %}
</section>
<footer id="attribution">
  <h2>出典</h2>
  <p>{{ set_data.attribution.wordlist.citation_ja }}</p>
  <p>{{ set_data.attribution.grammar_profile.citation_ja }}</p>
  <p>本教材は上記CEFR-J資料に基づいて生成されたものです。内容の教育利用にあたっては指導者が最終確認を行ってください。</p>
</footer>
<script>
(() => {
  "use strict";

  const screen = document.getElementById("screen-ui");
  if (!screen) {
    return;
  }

  const normalizeAnswer = (value) => value.normalize("NFC").trim().replace(/\s+/g, " ").toLowerCase();

  const updateCorrectScore = () => {
    const score = screen.querySelector(":scope > .score");
    if (!score) {
      return;
    }
    const questions = Array.from(screen.querySelectorAll(":scope > .question"));
    const correct = questions.filter((question) => question.dataset.correct === "true").length;
    score.textContent = `正解数: ${correct} / ${questions.length}`;
  };

  screen.querySelectorAll(".question[data-answer-index]").forEach((question) => {
    const answerIndex = JSON.parse(question.dataset.answerIndex);
    const choices = Array.from(question.querySelectorAll(".choice"));
    choices.forEach((choice) => {
      choice.addEventListener("click", () => {
        if (question.dataset.judged === "true") {
          return;
        }
        const selectedIndex = Number(choice.dataset.index);
        const correct = selectedIndex === answerIndex;
        question.dataset.judged = "true";
        question.dataset.correct = String(correct);
        choices.forEach((item) => {
          item.disabled = true;
        });
        const correctChoice = choices[answerIndex];
        correctChoice.classList.add("is-correct");
        const correctLabel = document.createElement("span");
        correctLabel.className = "judgement-label";
        correctLabel.lang = "ja";
        correctLabel.textContent = "（正解）";
        correctChoice.append(correctLabel);
        if (!correct) {
          choice.classList.add("is-wrong");
          const selectedLabel = document.createElement("span");
          selectedLabel.className = "judgement-label";
          selectedLabel.lang = "ja";
          selectedLabel.textContent = "（あなたの選択）";
          choice.append(selectedLabel);
        }
        question.querySelector(".feedback").textContent = correct ? "正解です" : "不正解です";
        const translation = question.querySelector(".translation-line");
        if (translation) {
          translation.hidden = false;
        }
        const explanation = question.querySelector(".explanation");
        if (explanation) {
          explanation.hidden = false;
          explanation.open = true;
        }
        updateCorrectScore();
      });
    });
  });

  screen.querySelectorAll(".deck").forEach((deck) => {
    const cards = Array.from(deck.querySelectorAll(".card"));
    const progress = deck.querySelector(".deck-progress");
    const summary = deck.querySelector(".deck-summary");
    const summaryScore = summary.querySelector(".score");
    const unknownHeading = summary.querySelector(".unknown-heading");
    const unknownList = summary.querySelector(".unknown-list");
    let current = 0;
    let known = 0;
    let unknown = [];

    const reveal = (card) => {
      if (card.dataset.state !== "front") {
        return;
      }
      card.dataset.state = "back";
      card.querySelector(".card-back").hidden = false;
      card.querySelector(".flip").hidden = true;
      card.querySelector(".mark-known").hidden = false;
      card.querySelector(".mark-unknown").hidden = false;
    };

    const finishCard = (card, remembered) => {
      if (card.dataset.state !== "back") {
        return;
      }
      if (remembered) {
        known += 1;
      } else {
        unknown.push(card.querySelector(".card-front").textContent.trim());
      }
      card.hidden = true;
      current += 1;
      if (current < cards.length) {
        cards[current].hidden = false;
        progress.textContent = `${current + 1} / ${cards.length}`;
        return;
      }
      progress.hidden = true;
      summary.hidden = false;
      summaryScore.textContent = `覚えた: ${known} / ${cards.length}`;
      unknownList.replaceChildren();
      unknown.forEach((text) => {
        const item = document.createElement("li");
        if (deck.dataset.format === "vocab_flashcard_en2ja") {
          item.lang = "en";
        }
        item.textContent = text;
        unknownList.append(item);
      });
      const noUnknown = unknown.length === 0;
      unknownHeading.hidden = noUnknown;
      unknownList.hidden = noUnknown;
    };

    cards.forEach((card) => {
      card.querySelector(".flip").addEventListener("click", () => reveal(card));
      card.querySelector(".mark-known").addEventListener("click", () => finishCard(card, true));
      card.querySelector(".mark-unknown").addEventListener("click", () => finishCard(card, false));
    });

    summary.querySelector(".restart").addEventListener("click", () => {
      current = 0;
      known = 0;
      unknown = [];
      summary.hidden = true;
      progress.hidden = false;
      progress.textContent = `1 / ${cards.length}`;
      cards.forEach((card, index) => {
        card.dataset.state = "front";
        card.hidden = index !== 0;
        card.querySelector(".card-back").hidden = true;
        card.querySelector(".flip").hidden = false;
        card.querySelector(".flip").disabled = false;
        card.querySelector(".mark-known").hidden = true;
        card.querySelector(".mark-known").disabled = false;
        card.querySelector(".mark-unknown").hidden = true;
        card.querySelector(".mark-unknown").disabled = false;
      });
    });
  });

  screen.querySelectorAll('.question[data-accepted]').forEach((question) => {
    const accepted = JSON.parse(question.dataset.accepted).map(normalizeAnswer);
    const input = question.querySelector("input");
    const check = question.querySelector(".check");
    const judge = () => {
      if (check.disabled || question.dataset.judged === "true") {
        return;
      }
      const rawAnswer = input.value;
      const correct = accepted.includes(normalizeAnswer(rawAnswer));
      question.dataset.judged = "true";
      question.dataset.correct = String(correct);
      input.disabled = true;
      check.disabled = true;
      question.querySelector(".feedback").textContent = correct ? "正解です" : "不正解です";
      if (!correct) {
        question.querySelector(".user-answer").textContent = rawAnswer;
        question.querySelector(".user-answer-line").hidden = false;
      }
      question.querySelector(".answer-line").hidden = false;
      const explanation = question.querySelector(".explanation");
      explanation.hidden = false;
      explanation.open = true;
      updateCorrectScore();
    };
    input.addEventListener("input", () => {
      check.disabled = normalizeAnswer(input.value) === "";
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !check.disabled) {
        event.preventDefault();
        judge();
      }
    });
    check.addEventListener("click", judge);
  });

  screen.querySelectorAll('.question[data-format="grammar_reorder"]').forEach((question) => {
    const expected = JSON.parse(question.dataset.answerTokens);
    const answerRow = question.querySelector(".answer-row");
    const bank = question.querySelector(".token-bank");
    const bankTokens = Array.from(bank.querySelectorAll(".token"));
    const reset = question.querySelector(".reset");
    const check = question.querySelector(".check");

    const updateCheck = () => {
      check.disabled = answerRow.querySelectorAll(".answer-token").length !== bankTokens.length;
    };

    const removeAnswerToken = (answerToken) => {
      if (question.dataset.judged === "true") {
        return;
      }
      const tokenText = answerToken.dataset.token;
      const bankToken = bankTokens.find(
        (candidate) => candidate.dataset.token === tokenText && candidate.classList.contains("is-used")
      );
      if (bankToken) {
        bankToken.disabled = false;
        bankToken.classList.remove("is-used");
      }
      answerToken.remove();
      updateCheck();
    };

    bankTokens.forEach((bankToken) => {
      bankToken.addEventListener("click", () => {
        if (question.dataset.judged === "true") {
          return;
        }
        bankToken.disabled = true;
        bankToken.classList.add("is-used");
        const answerToken = document.createElement("button");
        answerToken.type = "button";
        answerToken.className = "token answer-token";
        answerToken.lang = "en";
        answerToken.dataset.token = bankToken.dataset.token;
        answerToken.textContent = bankToken.dataset.token;
        answerToken.addEventListener("click", () => removeAnswerToken(answerToken));
        answerRow.append(answerToken);
        updateCheck();
      });
    });

    reset.addEventListener("click", () => {
      if (question.dataset.judged === "true") {
        return;
      }
      answerRow.replaceChildren();
      bankTokens.forEach((token) => {
        token.disabled = false;
        token.classList.remove("is-used");
      });
      updateCheck();
    });

    check.addEventListener("click", () => {
      if (check.disabled || question.dataset.judged === "true") {
        return;
      }
      const actual = Array.from(answerRow.querySelectorAll(".answer-token"), (token) => token.dataset.token);
      const correct = actual.length === expected.length && actual.every((token, index) => token === expected[index]);
      question.dataset.judged = "true";
      question.dataset.correct = String(correct);
      bankTokens.forEach((token) => {
        token.disabled = true;
      });
      answerRow.querySelectorAll(".answer-token").forEach((token) => {
        token.disabled = true;
      });
      reset.disabled = true;
      check.disabled = true;
      question.querySelector(".feedback").textContent = correct ? "正解です" : "不正解です";
      if (!correct) {
        question.querySelector(".user-answer").textContent = actual.join(" ");
        question.querySelector(".user-answer-line").hidden = false;
      }
      question.querySelector(".answer-line").hidden = false;
      const explanation = question.querySelector(".explanation");
      explanation.hidden = false;
      explanation.open = true;
      updateCorrectScore();
    });
  });

  const selfcheckQuestions = Array.from(
    screen.querySelectorAll('.question[data-format="grammar_example_selfcheck"]')
  );
  const updateSelfcheckScore = () => {
    const score = screen.querySelector(":scope > .score");
    const completed = selfcheckQuestions.filter((question) => question.dataset.result === "ok").length;
    score.textContent = `できた: ${completed} / ${selfcheckQuestions.length}`;
  };
  selfcheckQuestions.forEach((question) => {
    const reveal = question.querySelector(".reveal");
    const answerArea = question.querySelector(".answer-area");
    const markOk = question.querySelector(".mark-ok");
    const markNg = question.querySelector(".mark-ng");
    reveal.addEventListener("click", () => {
      if (question.dataset.state) {
        return;
      }
      question.dataset.state = "revealed";
      answerArea.hidden = false;
      reveal.disabled = true;
    });
    const finish = (result, text) => {
      if (question.dataset.state !== "revealed") {
        return;
      }
      question.dataset.state = "done";
      question.dataset.result = result;
      question.querySelector(".feedback").textContent = text;
      markOk.disabled = true;
      markNg.disabled = true;
      updateSelfcheckScore();
    };
    markOk.addEventListener("click", () => finish("ok", "できた"));
    markNg.addEventListener("click", () => finish("ng", "できなかった"));
  });
})();
</script>
</body>
</html>
